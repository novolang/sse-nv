// ssereader_tests.nv — the API suite for the line grammar and the
// stream parser.
//
// The cases are the ones the specification spells out: exactly one
// leading space removed from a field value, a bare carriage return as a
// line terminator, a block with no data dispatching nothing, and an id
// buffer that survives a dispatch.  The streams of section 9.2.6's
// examples are fed whole and byte by byte.

use std.test
use std.list
use std.str
use std.bytes
use sseevent
use ssewire
use ssereader

// Text as the byte list a reader is fed.
fn u8s(text: Str) -> [u8]
    bytes.to_byte_list(bytes.from_str(text))

// A reader with the default limits.
fn fresh() -> ssereader.SseReader
    ssereader.reader(ssereader.default_limits())

@test
fn test_exactly_one_leading_space_is_removed_from_a_value() [io]
    test.case("a space after the colon is not part of the value")
    match ssewire.parse_line("data: hello")
        SseFieldLine(_, v) => test.assert(v == "hello")
        _                  => test.fail("that is a field line")

    test.case("no space is the same value")
    match ssewire.parse_line("data:hello")
        SseFieldLine(_, v) => test.assert(v == "hello")
        _                  => test.fail("that is a field line")

    test.case("two spaces leave one, because exactly one is removed")
    match ssewire.parse_line("data:  hello")
        SseFieldLine(_, v) => test.assert(v == " hello")
        _                  => test.fail("that is a field line")

@test
fn test_the_four_line_shapes() [io]
    test.case("an empty line dispatches")
    match ssewire.parse_line("")
        SseDispatchLine => test.assert(true)
        _               => test.fail("an empty line is a dispatch")

    test.case("a leading colon is a comment, and the colon is not in the text")
    match ssewire.parse_line(":ping")
        SseCommentLine(t) => test.assert(t == "ping")
        _                 => test.fail("that is a comment")

    test.case("a comment's one leading space goes too")
    match ssewire.parse_line(": ping")
        SseCommentLine(t) => test.assert(t == "ping")
        _                 => test.fail("that is a comment")

    test.case("a line with no colon is a field with an empty value")
    match ssewire.parse_line("data")
        SseFieldLine(f, v) =>
            test.assert(v == "")
            test.assert(ssewire.field_name(f) == "data")
        _                  => test.fail("that is a field line")

@test
fn test_an_unknown_field_keeps_its_name_and_is_not_defined() [io]
    test.case("field names are case-sensitive, so Event is not event")
    match ssewire.field_of("Event")
        SseFieldOther(n) => test.assert(n == "Event")
        _                => test.fail("Event is not a defined field")

    test.case("and the four defined ones are")
    test.assert(ssewire.is_defined_field(ssewire.field_of("event")))
    test.assert(ssewire.is_defined_field(ssewire.field_of("data")))
    test.assert(ssewire.is_defined_field(ssewire.field_of("id")))
    test.assert(ssewire.is_defined_field(ssewire.field_of("retry")))
    test.assert(not ssewire.is_defined_field(ssewire.field_of("comment")))

@test
fn test_all_three_line_terminators_end_a_line() [io]
    test.case("a line feed")
    test.assert(list.len(ssewire.split_lines("a\nb\n").lines) == 2)

    test.case("a carriage return and line feed pair is one terminator")
    // A parser that split on each character sees a blank line between
    // every pair and dispatches a block on each.
    test.assert(list.len(ssewire.split_lines("a\r\nb\r\n").lines) == 2)

    test.case("and a bare carriage return, which implementations forget")
    test.assert(list.len(ssewire.split_lines("a\rb\rc").lines) == 2)

@test
fn test_an_unterminated_tail_is_held_back() [io]
    test.case("what follows the last terminator is the remainder")
    let s = ssewire.split_lines("a\nb\nc")
    test.assert(list.len(s.lines) == 2)
    test.assert(s.remainder == "c")

    test.case("text ending on a terminator has no remainder")
    test.assert(ssewire.split_lines("a\n").remainder == "")

    test.case("a lone trailing carriage return is held back, not consumed")
    // The next byte may be the line feed that belongs to it, and
    // consuming it would make one terminator into two.
    let t = ssewire.split_lines("a\r")
    test.assert(list.len(t.lines) == 0)
    test.assert(t.remainder == "a\r")
    let u = ssewire.split_lines(t.remainder + "\nb\n")
    test.assert(list.len(u.lines) == 2)

@test
fn test_a_retry_value_is_digits_or_it_is_ignored() [io]
    test.case("digits are acted on")
    test.assert(ssewire.is_retry_value("5000"))
    test.assert(ssewire.is_retry_value("0"))

    test.case("anything else is ignored, and the previous time stands")
    test.assert(not ssewire.is_retry_value("5s"))
    test.assert(not ssewire.is_retry_value("-1"))
    test.assert(not ssewire.is_retry_value("5.0"))
    test.assert(not ssewire.is_retry_value(""))

@test
fn test_a_block_with_data_dispatches_one_event() [io]
    test.case("two lines and a blank one are an event")
    match ssereader.feed(fresh(), u8s("data: hello\n\n")).signal
        None    => test.fail("a complete block dispatches")
        Some(s) =>
            match s
                SseDispatch(e) =>
                    test.assert(e.data == "hello")
                    test.assert(e.kind == "message")
                    test.assert(e.id == "")
                _              => test.fail("a block with data dispatches an event")

@test
fn test_a_block_with_no_data_dispatches_nothing() [io]
    // The rule a decoder breaks by firing an empty event: a server that
    // uses a bare `id` line as its heartbeat would deliver one every
    // few seconds.
    test.case("an id line alone updates the id and fires no event")
    let step = ssereader.feed(fresh(), u8s("id: 42\n\n"))
    match step.signal
        Some(SseDispatch(_)) => test.fail("an empty data buffer dispatches nothing")
        _                    => test.assert(true)

    test.case("but the id took effect")
    test.assert(ssereader.last_event_id(step.reader) == "42")

@test
fn test_several_data_lines_are_joined_by_newlines() [io]
    test.case("three data fields become one event of three lines")
    match ssereader.feed(fresh(), u8s("data: a\ndata: b\ndata: c\n\n")).signal
        Some(SseDispatch(e)) =>
            test.assert(e.data == "a\nb\nc")
            test.assert(list.len(sseevent.data_lines(e)) == 3)
        _                    => test.fail("that is one event")

    test.case("and the trailing newline the parser appends is removed")
    match ssereader.feed(fresh(), u8s("data: a\n\n")).signal
        Some(SseDispatch(e)) => test.assert(not str.ends_with(e.data, "\n"))
        _                    => test.fail("that is one event")

@test
fn test_the_id_survives_a_dispatch_and_the_type_does_not() [io]
    // The whole of the resumption mechanism: the id buffer is not reset
    // between events, and the event type buffer is.
    let r = fresh()
    test.case("an event with an id and a type")
    let first = ssereader.feed(r, u8s("event: update\nid: 7\ndata: a\n\n"))
    match first.signal
        Some(SseDispatch(e)) =>
            test.assert(e.kind == "update")
            test.assert(e.id == "7")
        _                    => test.fail("that is one event")

    test.case("the next event carries the same id although it sent none")
    match ssereader.feed(first.reader, u8s("data: b\n\n")).signal
        Some(SseDispatch(e)) =>
            test.assert(e.id == "7")
            test.case("and its type went back to the default")
            test.assert(e.kind == "message")
        _                    => test.fail("that is one event")

@test
fn test_an_id_holding_a_null_is_ignored() [io]
    test.case("a NULL in an id keeps the previous id")
    test.assert(not sseevent.id_is_usable("4\u{0}2"))
    test.assert(sseevent.id_is_usable("42"))

@test
fn test_a_retry_field_sets_the_reconnection_time_and_reports_it() [io]
    test.case("a retry line is a signal of its own")
    let step = ssereader.feed(fresh(), u8s("retry: 5000\n"))
    match step.signal
        Some(SseRetry(ms)) => test.assert(ms == 5000)
        _                  => test.fail("a retry line reports itself")

    test.case("and the reader keeps it")
    test.assert(ssereader.retry_millis(step.reader) == 5000)

    test.case("a retry that is not digits leaves the time alone")
    let before = ssereader.retry_millis(fresh())
    let after = ssereader.feed(fresh(), u8s("retry: 5s\n"))
    test.assert(ssereader.retry_millis(after.reader) == before)

@test
fn test_a_comment_is_reported_and_is_not_an_event() [io]
    // A comment is how nearly every server keeps a connection alive
    // through a proxy's idle timeout, so a client watching for a dead
    // stream is watching for these.
    test.case("a comment line is its own signal")
    match ssereader.feed(fresh(), u8s(":ping\n")).signal
        Some(SseComment(t)) => test.assert(t == "ping")
        _                   => test.fail("a comment reports itself")

@test
fn test_an_event_fed_in_pieces_is_one_event() [io]
    // The case a developer never sees on localhost.
    let r = fresh()
    test.case("a prefix produces nothing")
    let a = ssereader.feed(r, u8s("data: he"))
    match a.signal
        Some(_) => test.fail("that block has not ended")
        None    => test.assert(ssereader.pending_len(a.reader) > 0)

    test.case("and the rest completes it")
    match ssereader.feed(a.reader, u8s("llo\n\n")).signal
        Some(SseDispatch(e)) => test.assert(e.data == "hello")
        _                    => test.fail("the block is complete now")

@test
fn test_feed_takes_one_and_take_gets_the_rest() [io]
    test.case("two events in one read")
    let a = ssereader.feed(fresh(), u8s("data: a\n\ndata: b\n\n"))
    match a.signal
        Some(SseDispatch(e)) => test.assert(e.data == "a")
        _                    => test.fail("the first event is complete")

    test.case("and the second comes from take")
    let b = ssereader.take(a.reader)
    match b.signal
        Some(SseDispatch(e)) => test.assert(e.data == "b")
        _                    => test.fail("the second event is complete")

    test.case("and then there is nothing left")
    match ssereader.take(b.reader).signal
        Some(_) => test.fail("only two events were fed")
        None    => test.assert(true)

@test
fn test_a_partial_block_is_discarded_at_the_close() [io]
    // The stream ended in the middle of an event, so the event was
    // never dispatched.  Delivering it would deliver something the
    // server did not finish sending.
    test.case("a block with no blank line after it is dropped")
    let a = ssereader.feed(fresh(), u8s("data: half"))
    match ssereader.finish(a.reader).signal
        Some(_) => test.fail("an unfinished block is not dispatched")
        None    => test.assert(true)

@test
fn test_an_oversized_block_is_dropped_and_the_stream_continues() [io]
    // Not a fault: the specification has no size limit, and a client
    // that disconnected on one would be killed by a server having a bad
    // day.
    let small = ssereader.reader(ssereader.small_limits())
    test.case("a block over the limit reports an overflow")
    let big = str.repeat("x", 8192)
    match ssereader.feed_text(small, "data: ${big}\n\n").signal
        Some(SseOverflow(n)) => test.assert(n > 0)
        _                    => test.fail("that block is over the small limit")

@test
fn test_a_resuming_reader_starts_with_the_id_it_was_given() [io]
    // A client that reconnected with a fresh reader reports "" as the
    // id of every event until the server sends another one, and then
    // resumes from the beginning after the next drop.
    test.case("the id is in force before any event arrives")
    let r = ssereader.resuming(ssereader.default_limits(), "42")
    test.assert(ssereader.last_event_id(r) == "42")

    test.case("and an event that sends no id carries it")
    match ssereader.feed(r, u8s("data: a\n\n")).signal
        Some(SseDispatch(e)) => test.assert(e.id == "42")
        _                    => test.fail("that is one event")

// ── Section 9.2.6's example streams ─────────────────────────────────

// Every signal a reader produces from `text`, fed in pieces of `size`
// bytes.
fn signals_of(text: Str, size: Int) -> [ssereader.SseSignal]
    var out: [ssereader.SseSignal] = []
    var r = fresh()
    let n = str.len(text)
    for k in 0..(n + size - 1) / size
        let i = k * size
        var end = i + size
        if end > n
            end = n
        var step = ssereader.feed_text(r, str.slice(text, i, end))
        loop
            match step.signal
                Some(s) => list.push(out, s)
                None    =>
                    break
            step = ssereader.take(step.reader)
        r = step.reader
    out

// The events among `signals`, as `type|data|id` strings.
fn events_of(signals: [ssereader.SseSignal]) -> [Str]
    var out: [Str] = []
    for s in signals
        if let SseDispatch(e) = s
            list.push(out, "${e.kind}|${e.data}|${e.id}")
    out

fn assert_events(text: Str, want: [Str])
    for size in [1, 2, 3, 7, 1000]
        test.assert(events_of(signals_of(text, size)) == want)

@test
fn test_the_stock_ticker_example() [io]
    // "data: YHOO", "data: +2", "data: 10" dispatch "YHOO\n+2\n10".
    assert_events("data: YHOO\ndata: +2\ndata: 10\n\n", ["message|YHOO\n+2\n10|"])

@test
fn test_the_four_block_example() [io]
    // A comment, an event with id 1, an event that resets the id with a
    // bare `id` line, and an event whose data keeps one leading space.
    let text = ": test stream\n\ndata: first event\nid: 1\n\ndata:second event\nid\n\ndata:  third event\n\n"
    assert_events(text, ["message|first event|1", "message|second event|", "message| third event|"])

@test
fn test_the_empty_data_example() [io]
    // "data" dispatches empty data, "data\ndata" dispatches one
    // newline, and a final block with no blank line after it is
    // discarded.
    assert_events("data\n\ndata\ndata\n\ndata:", ["message||", "message|\n|"])

@test
fn test_the_two_identical_events_example() [io]
    assert_events("data:test\n\ndata: test\n\n", ["message|test|", "message|test|"])

@test
fn test_the_add_and_remove_example() [io]
    let text = "event: add\ndata: 73857293\n\nevent: remove\ndata: 2153\n\nevent: add\ndata: 113411\n\n"
    assert_events(text, ["add|73857293|", "remove|2153|", "add|113411|"])

@test
fn test_every_terminator_and_a_byte_order_mark() [io]
    let want = ["message|a|", "message|b|"]
    assert_events("data: a\r\rdata: b\r\r", want)
    assert_events("data: a\r\n\r\ndata: b\r\n\r\n", want)
    assert_events("\u{FEFF}data: a\n\ndata: b\n\n", want)
    test.case("a byte order mark later in the stream is not removed")
    assert_events("data: a\n\n\u{FEFF}data: b\n\n", ["message|a|"])

@test
fn test_an_unknown_field_and_a_colonless_line_are_ignored() [io]
    assert_events("Data: x\nfoo: y\nbar\ndata: z\n\n", ["message|z|"])
    test.case("an empty event field leaves the default type")
    assert_events("event:\ndata: x\n\n", ["message|x|"])

@test
fn test_an_id_holding_a_null_keeps_the_previous_id() [io]
    assert_events("id: 1\ndata: a\n\nid: 2\u{0}\ndata: b\n\n", ["message|a|1", "message|b|1"])

@test
fn test_a_retry_too_large_to_hold_is_ignored() [io]
    let step = ssereader.feed(fresh(), u8s("retry: 99999999999999999999999\n"))
    test.assert(ssereader.retry_millis(step.reader) == 3000)

@test
fn test_an_overlong_line_drops_its_block_and_the_stream_continues() [io]
    let small = ssereader.reader(ssereader.small_limits())
    let big = str.repeat("x", 600)
    test.case("a line past the limit, arriving unterminated")
    var step = ssereader.feed_text(small, "data: a\ndata: ${big}")
    test.assert(ssereader.pending_len(step.reader) == 0)
    step = ssereader.feed_text(step.reader, "yy\nevent: e\n\ndata: next\n\n")
    match step.signal
        // `a` and its newline, the 606 bytes of the long line and the
        // `yy` that ends it, and `event: e` with its newline.
        Some(SseOverflow(n)) => test.assert(n == 2 + 606 + 3 + 9)
        _                    => test.fail("the block was dropped")
    match ssereader.take(step.reader).signal
        Some(SseDispatch(e)) =>
            test.assert(e.data == "next")
            test.assert(e.kind == "message")
        _                    => test.fail("the stream continues after the blank line")

@test
fn test_finish_keeps_the_id_and_the_retry_time() [io]
    let step = ssereader.feed_text(fresh(), "id: 9\nretry: 100\ndata: half")
    let after = ssereader.take(step.reader)
    let done = ssereader.finish(after.reader)
    test.assert(ssereader.last_event_id(done.reader) == "9")
    test.assert(ssereader.retry_millis(done.reader) == 100)
    test.assert(ssereader.pending_len(done.reader) == 0)
    test.assert(ssereader.small_limits().max_event_bytes == 4096)

@test
fn test_the_terminator_of_an_overlong_line_is_not_a_blank_line() [io]
    let small = ssereader.reader(ssereader.small_limits())
    let big = str.repeat("x", 600)
    var step = ssereader.feed_text(small, "data: ${big}")
    step = ssereader.feed_text(step.reader, "\r")
    test.case("the long line's own terminator dispatches nothing")
    match step.signal
        Some(_) => test.fail("that CR ends the long line")
        None    => test.assert(true)
    step = ssereader.feed_text(step.reader, "\ndata: b\n\n")
    match step.signal
        Some(SseOverflow(n)) => test.assert(n == 606 + 1 + 8)
        _                    => test.fail("the block was dropped")

@test
fn test_the_field_names_and_the_empty_data_lines() [io]
    test.assert(ssewire.field_name(SseFieldEvent) == "event")
    test.assert(ssewire.field_name(SseFieldId) == "id")
    test.assert(ssewire.field_name(SseFieldRetry) == "retry")
    test.assert(ssewire.field_name(SseFieldOther("x")) == "x")
    test.assert(list.len(sseevent.data_lines(sseevent.message(""))) == 0)

@test
fn test_an_overlong_line_arriving_over_several_reads_is_dropped_whole() [io]
    let small = ssereader.reader(ssereader.small_limits())
    let big = str.repeat("x", 600)
    var step = ssereader.feed_text(small, "data: ${big}")
    step = ssereader.feed_text(step.reader, "more")
    test.assert(ssereader.pending_len(step.reader) == 0)
    step = ssereader.feed_text(step.reader, "\n\n")
    match step.signal
        Some(SseOverflow(n)) => test.assert(n == 606 + 4 + 1)
        _                    => test.fail("the block was dropped")
