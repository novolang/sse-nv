// ssereconnect.nv — what a client does when the connection ends, as a
// value rather than as a loop.
//
// A client whose event stream ends reconnects after the reconnection
// time, sending its last event id back in a `Last-Event-ID` header.
// That is the ordinary case (section 9.2.3).
//
// A response is a permanent stop when its status is not 200, or when
// its `Content-Type` is not `text/event-stream`: the specification says
// to "fail the connection", and a failed connection is not retried.  A
// 204 No Content is the one a server uses on purpose, to tell clients to
// go away.  A network error, where no response arrived, is retried, and
// so is a 200 stream that simply ended.
//
// This package does not wait.  The reconnection time is a number this
// module computes, and the caller sleeps it.

use std.str

// What a client should do after a connection ends.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     match ssereconnect.after_close(204, "text/event-stream", 3000)
//         SseStopPermanently(why) => println(why)
//         SseReconnectAfter(ms)   => println("${ms}")
// ```
pub enum SseAfterClose
    // Wait this many milliseconds, then open the stream again with the
    // `Last-Event-ID` header set.
    SseReconnectAfter(millis: Int)
    // Do not reconnect.  `why` says which of the permanent cases this
    // was, for a log.
    SseStopPermanently(why: Str)

// The decision, from the response the server gave and the reconnection
// time in force.
//
// `status` is the response's status, or 0 when no response arrived.  A
// status other than 200 answers `SseStopPermanently`, and so does a 200
// whose media type is not `text/event-stream`.  A status of 0 and a 200
// event stream that ended answer `SseReconnectAfter` with the time
// given.
//
// `content_type` is the header's value as received, parameters and all.
// `text/event-stream; charset=utf-8` is an event stream: the comparison
// is on the media type alone and ignores case.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     match ssereconnect.after_close(0, "", 3000)
//         SseReconnectAfter(ms)   => println("retry in ${ms}ms")   // retry in 3000ms
//         SseStopPermanently(_)   => println("stop")
// ```
pub fn after_close(status: Int, content_type: Str, retry_millis: Int) -> SseAfterClose []
    if is_permanent_status(status)
        return SseStopPermanently("status ${status}")
    if status == 200 and not is_event_stream(content_type)
        return SseStopPermanently("content type ${content_type}")
    SseReconnectAfter(retry_millis)

// Whether a `Content-Type` header value is an event stream.
//
// True for `text/event-stream` with any parameters and in any case.
// False for everything else, including an empty header: a response with
// no media type is not an event stream.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     println("${ssereconnect.is_event_stream("text/event-stream; charset=utf-8")}")
//     println("${ssereconnect.is_event_stream("text/plain")}")   // false
// ```
pub fn is_event_stream(content_type: Str) -> Bool []
    var media = content_type
    if let Some(at) = str.index(content_type, ";")
        media = str.slice(content_type, 0, at)
    str.lower(str.trim(media)) == "text/event-stream"

// Whether a status means stop for good rather than retry.
//
// True for every status except 200, the one a working stream answers.
// False for 0, which stands for a network error where no response
// arrived and which the specification retries.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     println("${ssereconnect.is_permanent_status(204)}")   // true
//     println("${ssereconnect.is_permanent_status(0)}")     // false
// ```
pub fn is_permanent_status(status: Int) -> Bool []
    status != 200 and status != 0

// The reconnection time a client starts with, in milliseconds.
//
// The specification leaves this to the implementation, "probably in
// the region of a few seconds".  This package says three seconds, and a
// server that wants another number sends a `retry` field.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     println("${ssereconnect.default_retry_millis()}")     // 3000
// ```
pub fn default_retry_millis() -> Int []
    3000

// The `Last-Event-ID` request header a reconnecting client sends, or
// `None` when it has no id to send.
//
// `None` rather than an empty header, because the two mean different
// things to a server: an absent header is a client starting fresh, and
// a present empty one is a client claiming to have seen an event whose
// id was the empty string.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     match ssereconnect.last_event_id_header("42")
//         None    => println("no header")
//         Some(v) => println(v)                             // 42
// ```
pub fn last_event_id_header(last_event_id: Str) -> ?Str []
    if last_event_id == ""
        return None
    Some(last_event_id)

// The name of that header.
//
// The spelling is the specification's: `Last-Event-ID`, with the last
// two letters capitalised.  HTTP field names are case-insensitive, and
// servers that match them case-sensitively exist.
//
// ```novo
// use ssereconnect
//
// fn main() [io]
//     println(ssereconnect.last_event_id_header_name())     // Last-Event-ID
// ```
pub fn last_event_id_header_name() -> Str []
    "Last-Event-ID"
