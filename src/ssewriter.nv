// ssewriter.nv — a server's side: an event turned back into the lines a
// stream is made of.
//
// A field's value cannot contain a line terminator, because a
// terminator ends the line.  So an event whose data is three lines is
// written as three `data` fields, and the decoder joins them back
// together.  A server that wrote `data: ${text}` with a text holding a
// newline has sent a block whose second line is whatever came after it,
// and a value that happened to start with `event:` has changed the
// event's type.  The specification's terminators include a bare
// carriage return, so `encode` splits data on all three.
//
// Every event is encodable.  An id that `sseevent.id_is_usable` refuses
// is left out rather than written, and a type holding a terminator is
// written up to the first one.

use std.str
use sseevent

// One event as the block a server writes, terminated by the blank line
// that dispatches it.
//
// The data is split on every line terminator and written as one `data`
// field per line, which is the only correct encoding for multi-line
// data.  An `event` field is written only when the type is not
// `"message"`, and an `id` field only when the id is non-empty and
// usable, which keeps a stream of ordinary messages down to two lines
// each.  A non-empty id is written before the data, so a reader that
// sees the event sees its id in force.
//
// ```novo
// use sseevent
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.encode(sseevent.message("hello")))
// ```
pub fn encode(e: sseevent.SseEvent) -> Str []
    var out = ""
    let kind = first_line(e.kind)
    if kind != "" and kind != "message"
        out = out + "event: " + kind + "\n"
    if e.id != "" and sseevent.id_is_usable(e.id)
        out = out + "id: " + e.id + "\n"
    for line in lines_of(e.data)
        out = out + "data: " + line + "\n"
    out + "\n"

// Several events, one after another.
//
// ```novo
// use sseevent
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.encode_all([sseevent.message("a"),
//                                   sseevent.message("b")]))
// ```
pub fn encode_all(events: [sseevent.SseEvent]) -> Str []
    var out = ""
    for e in events
        out = out + encode(e)
    out

// A `data`-only block, which dispatches an event of the default type.
//
// The shortest thing a server can send that a browser's `EventSource`
// delivers: two lines and a blank one.
//
// ```novo
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.data("hello"))
// ```
pub fn data(text: Str) -> Str []
    encode(sseevent.message(text))

// A comment line.
//
// A colon, the text, and a terminator.  The parser ignores it, which is
// exactly what makes it useful: a comment sent every few seconds keeps
// a proxy from closing an idle connection, and costs the client
// nothing.
//
// A comment's text may not contain a line terminator; one that does is
// written as several comment lines, so the result is still ignorable.
// A line that begins with a space is written after `: ` so the space
// survives the one the parser removes.
//
// ```novo
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.comment("ping"))                    // :ping
// ```
pub fn comment(text: Str) -> Str []
    var out = ""
    for line in lines_of(text)
        if str.starts_with(line, " ")
            out = out + ": " + line + "\n"
        else
            out = out + ":" + line + "\n"
    out

// The keep-alive a server sends to hold a connection open: a comment
// with no text.
//
// One colon and a terminator, which is the smallest thing that passes
// through a proxy's idle timer.  Named rather than left to each server
// to invent, because a server that invented a `data:` heartbeat instead
// delivers an empty event to every client.
//
// ```novo
// use ssewriter
//
// fn main() [io]
//     println("${str.len(ssewriter.keep_alive())}")
// ```
pub fn keep_alive() -> Str []
    ":\n"

// A `retry` line, setting the client's reconnection time in
// milliseconds.
//
// A negative value is written as zero rather than refused.  The
// specification's parser ignores a `retry` value that is not all digits,
// so a minus sign would leave the client on whatever time it had.
//
// ```novo
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.retry(5000))                        // retry: 5000
// ```
pub fn retry(millis: Int) -> Str []
    if millis < 0
        return "retry: 0\n"
    "retry: ${millis}\n"

// An `id` line on its own, updating the client's last event id without
// dispatching an event.
//
// A block of nothing but an `id` line dispatches nothing, because the
// data buffer is empty.  This is how a server moves a client's
// resumption point past events it does not need to replay.  An id that
// `sseevent.id_is_usable` refuses is written as an empty id.
//
// ```novo
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.id_only("42"))
// ```
pub fn id_only(id: Str) -> Str []
    if sseevent.id_is_usable(id)
        return "id: " + id + "\n\n"
    "id\n\n"

// The `Content-Type` header value a server must send.
//
// `text/event-stream`.  A response with any other media type is not an
// event stream, and the specification requires a client to fail the
// connection permanently rather than reconnect.
//
// ```novo
// use ssewriter
//
// fn main() [io]
//     println(ssewriter.content_type())                     // text/event-stream
// ```
pub fn content_type() -> Str []
    "text/event-stream"

// `text` split at every CR LF, LF and CR.  An empty text is one empty
// line, which is how empty data is written.
fn lines_of(text: Str) -> [Str]
    let unix = str.replace_all(str.replace_all(text, "\r\n", "\n"), "\r", "\n")
    str.split(unix, "\n")

// `text` up to its first line terminator.
fn first_line(text: Str) -> Str
    lines_of(text)[0]
